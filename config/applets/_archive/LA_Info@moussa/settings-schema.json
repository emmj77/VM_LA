{
  "metricsUrl": {
    "type": "entry",
    "default": "http://127.0.0.1:8088/metrics",
    "description": "Llama.cpp Metrics Endpoint URL",
    "tooltip": "L adresse des mesures de notre llama.cpp"
  },
  "llamaPollIntervalMs": {
    "type": "spinbutton",
    "default": 5000,
    "min": 500,
    "max": 10000,
    "step": 500,
    "units": "milliseconds",
    "description": "LLM Metrics Polling Interval",
    "tooltip": "How frequently to refresh LLM metrics from the server"
  },
  "hwPollIntervalMs": {
    "type": "spinbutton",
    "default": 1000,
    "min": 500,
    "max": 10000,
    "step": 500,
    "units": "milliseconds",
    "description": "Hardware Metrics Polling Interval",
    "tooltip": "How frequently to refresh hardware metrics from the system"
  }
}
