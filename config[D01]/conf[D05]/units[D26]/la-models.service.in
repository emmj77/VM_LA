# id: U01
# THE ROUTER: ONE llama-server, THREE models (the embed, the reranker, the compactor).
# install.sh remplace @ROOT@ par la racine reelle et pose le fichier dans ~/.config/systemd/user/.
# Le depot porte la source, le poste porte l'unite.
#
# WHY A SINGLE ONE: MOUSSA, 19/10: 'switch to the single router' -- one unit, one door, one
# log, and each model settings written once (config/llama_preset.ini).
# WHAT IT COSTS: 305 MB more than three separate residents (each model stays a child
# PROCESS with its libraries). Measured 19/10: 2 763 MB against 2 458 MB.
# WHAT IT GIVES: unused models give their memory back (sleep-idle-seconds), and a model
# absent loads on the first request instead of making the turn fail.
[Unit]
Description=LA - the models (one llama.cpp router : embed, rerank, compactor -- loaded on demand, kept while used)
After=default.target

[Service]
Type=simple
ExecStart=@ROOT@/config/engine/models.sh run
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
