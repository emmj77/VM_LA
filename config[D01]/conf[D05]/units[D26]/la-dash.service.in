# id: U04
# A TEMPLATE, NOT A LIVE UNIT: install.sh replaces @ROOT@ par la racine reelle et
# sets the file in ~/.config/systemd/user/. The repo carries the source, the station carries the unit.
[Unit]
Description=LA - the station page (dash.py, a door on the harness)
Documentation=file://@ROOT@/projects/la/spec.yaml
After=network.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=/usr/bin/python3 config/programs/dash.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
