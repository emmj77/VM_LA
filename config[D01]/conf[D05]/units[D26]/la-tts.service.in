# id: U03
# A TEMPLATE, NOT A LIVE UNIT: install.sh replaces @ROOT@ par la racine reelle et
# sets the file in ~/.config/systemd/user/. The repo carries the source, the station carries the unit.
[Unit]
Description=LA - TTS (resident voice, Piper upmc, model loaded once)
After=default.target

[Service]
Type=simple
ExecStart=@ROOT@/config/engine/tts.sh run
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
