{"status":"ok","tool":"doctor.index","line":"\n_op=${1:-tree}\n_ix=$(cfg abs index_la) || { printf 'FAULT no index in the tree\\n'; exit 0; }\ncase $_op in\ntree)\n  _n=0; _miss=0\n  _tf=$(tmpfile idxmiss) || exit 0\n  : > \"$_tf\"\n  # les entrees d etat (id N..) naissent a l usage : elles ne sont pas un defaut absentes\n  grep -oE '\\{id: \"[^\"]+\", name: \"[^\"]+\"' \"$_ix\" \\\n    | sed 's/^{id: \"//; s/\", name: \"/\\t/; s/\"$//' | while IFS=\"$(printf '\\t')\" read -r _id _p; do\n    case $_id in N[0-9]*) continue ;; esac\n    _a=$(cfg where \"$_p\")\n    [ -e \"$_a\" ] || printf 'FAULT the index names %s and the disk holds nothing\\n' \"$_p\"\n  done > \"$_tf\"\n  cat \"$_tf\"\n  _miss=$(grep -c . \"$_tf\")\n  _n=$(grep -cE 'name: \"' \"$_ix\")\n  printf 'note %s path(s) in the index, %s absent from the disk\\n' \"$_n\" \"${_miss:-0}\"\n  _tf=$(tmpfile idxextra)\n  ( cd \"$ROOT\" && find . -type f \\( -name '*.yaml' -o -name '*.yml' -o -name '*.sh' -o -name '*.py' -o -name '*.md' -o -name '*.txt' -o -name '*.json' -o -name '*.html' -o -name '*.css' -o -name '*.js' \\) \\\n      -not -path './.git*' -not -path './work*' -not -path './skills*' -not -path './projects*' -not -path './docs*' \\\n      -not -path './config*/state*' -not -path './config*/audio*' -not -path './config*/data*' \\\n      -not -name 'tool_*.yaml' -not -path '*/__pycache__/*' ) | sed 's|^\\./||' | sort | while IFS= read -r _f; do\n    grep -qF \"name: \\\"$(basename -- \"$_f\")\\\"\" \"$_ix\" || printf 'note %s is on the disk and the index does not name it\\n' \"$_f\"\n  done > \"$_tf\"\n  cat \"$_tf\"\n  printf 'note %s file(s) on the disk and outside the index\\n' \"$(grep -c . \"$_tf\")\"\n  ;;\n*) printf 'FAULT unknown op %s\\n' \"$_op\" ;;\nesac\nexit 0","result":"note 131 path(s) in the index, 0 absent from the disk\nnote 0 file(s) on the disk and outside the index","ts":1792557502,"return":""}
