{"status":"ok","tool":"doctor.texts","line":"\n_op=${1:-prompt}\n_hl=$(_flat | awk -F'\\t' '$1 ~ /^head\\.[A-Z_]+\\.[0-9]+$/ { n++ } END { print n+0 }')\n_hzo=$(_flat | awk -F'\\t' '$1 ~ /^head\\.[A-Z_]+\\.[0-9]+$/ { z = $1; sub(/\\.[0-9]+$/, \"\", z); s[z] = 1 } END { for (k in s) n++; print n+0 }')\nif [ \"${_hl:-0}\" = 0 ]; then\n  printf 'FAULT the head is empty: the model would start with no law\\n'\nelse\n  printf 'ok head %s line(s) in %s zone(s), held by la_config\\n' \"$_hl\" \"${_hzo:-0}\"\nfi\n_tx=$(cfg abs texts) || { printf 'FAULT no texts in the tree\\n'; exit 0; }\nfor _k in tool_unknown arity timeout tool_not_allowed approval_required path_outside_canon; do\n  msg_has \"refusals.$_k\" || printf 'FAULT the door says refusals.%s and texts has no such key\\n' \"$_k\"\ndone\n_accent=$(printf '\\303')\n_fr=$(LC_ALL=C grep -c \"$_accent\" \"$_tx\" 2>/dev/null)\n[ \"${_fr:-0}\" = 0 ] && printf 'ok no accented letter in texts\\n' \\\n  || printf 'FAULT %s line(s) of texts carry an accented letter\\n' \"$_fr\"\nexit 0","result":"ok head 45 line(s) in 9 zone(s), held by la_config\nok no accented letter in texts","ts":1792557502,"return":""}
