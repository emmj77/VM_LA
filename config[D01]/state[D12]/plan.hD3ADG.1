{"status":"ok","tool":"doctor.data","line":"\n_op=${1:-bases}\ncase $_op in\nbases)\n  for _k in sessions memory; do\n    _f=$(cfg abs \"$_k\" 2>/dev/null)\n    if [ -z \"$_f\" ] || [ ! -f \"$_f\" ]; then printf 'note no base %s (it is born at the first use)\\n' \"$_k\"; continue; fi\n    _v=$(sqlite3 \"$_f\" 'pragma quick_check;' 2>&1 | head -n 1)\n    [ \"$_v\" = ok ] && printf 'ok %s holds\\n' \"$_k\" || printf 'FAULT %s is malformed: %s\\n' \"$_k\" \"$_v\"\n  done\n  _f=$(cfg abs sessions 2>/dev/null)\n  [ -f \"$_f\" ] || exit 0\n  _m=$(sqlite3 \"$_f\" 'pragma journal_mode;' 2>/dev/null)\n  [ \"$_m\" = wal ] || printf 'note sessions.db runs in %s: a reader cannot live beside the writer\\n' \"${_m:-?}\"\n  ;;\nmemory)\n  _f=$(cfg abs memory 2>/dev/null)\n  [ -f \"$_f\" ] || { printf 'note no memory base (it is born at the first turn)\\n'; exit 0; }\n  _n=$(sqlite3 \"$_f\" 'select count(*) from memory;' 2>/dev/null)\n  _v=$(sqlite3 \"$_f\" 'select count(vec) from memory;' 2>/dev/null)\n  printf 'ok memory %s entrie(s), %s with a vector\\n' \"${_n:-0}\" \"${_v:-0}\"\n  [ \"${_n:-0}\" = \"${_v:-0}\" ] || printf 'note %s entrie(s) read by words only\\n' \"$(( ${_n:-0} - ${_v:-0} ))\"\n  ;;\n*) printf 'FAULT unknown op %s\\n' \"$_op\" ;;\nesac\nexit 0","result":"ok sessions holds\nok memory holds","ts":1792557501,"return":""}
