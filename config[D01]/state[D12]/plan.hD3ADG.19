{"status":"ok","tool":"doctor.tools","line":"_op=${1:-table}\n# LA TABLE DES CORPS SE COMPARE AU REGISTRE DES OUTILS (MOUSSA, 21/10) : _door_register\n# rend le registre du moteur quand la porte appelle un outil moteur, donc 41 identifiants\n# contre 2535 corps, et 2494 faux etrangers.\n_reg=$(cfg abs registry 2>/dev/null) || _reg=$(_door_register) || { printf 'FAULT no register\\n'; exit 0; }\n[ -r \"$_reg\" ] || { printf 'FAULT the register is not on the disk\\n'; exit 0; }\n_td=$(cfg path tools) || { printf 'FAULT no tools directory\\n'; exit 0; }\n_t=$(tmpfile doctor_tools) || exit 0\ncase $_op in\ntable)\n  awk '\n    /^[ \\t]*- id:[ \\t]*/ { id = $0; sub(/.*id:[ \\t]*/, \"\", id); gsub(/[^0-9A-Za-z]/, \"\", id)\n                            if (id in seen) dup = dup \" \" id; seen[id] = 1; next }\n    /^[ \\t]*family:[ \\t]*/ { v = $0; sub(/.*family:[ \\t]*/, \"\", v); gsub(/\"/, \"\", v)\n                              if (id != \"\") printf \"%s\\t%s\\n\", id, v }\n    END { if (dup != \"\") printf \"FAULT the register uses an id twice:%s\\n\", dup }\n  ' \"$_reg\" > \"$_t.reg\"\n  # the body says its own id: the file name is not the identity.\n  # UN SEUL awk POUR LES 2500 CORPS (MOUSSA, 21/10) : un awk par fichier prenait 26 s.\n  awk '\n    FNR == 1 {\n      if (name != \"\" && id == \"\") printf \"MISSING\\t%s\\n\", name\n      name = FILENAME ; id = \"\" ; taken = 0\n      d = FILENAME ; sub(/\\/[^\\/]*$/, \"\", d) ; sub(/.*\\//, \"\", d) ; sub(/\\[.*/, \"\", d)\n      fam = toupper(d)\n    }\n    !taken && /^id:[ \\t]*/ { v = $0 ; sub(/^id:[ \\t]*/, \"\", v) ; gsub(/[^0-9A-Za-z]/, \"\", v) ; id = v ; taken = 1 ; next }\n    taken == 1 { if (id != \"\") printf \"%s\\t%s\\n\", id, fam ; taken = 2 }\n    END { if (name != \"\" && id == \"\") printf \"MISSING\\t%s\\n\", name }\n  ' \"$_td\"/*/tool_*.yaml > \"$_t.all\"\n  grep '^MISSING' \"$_t.all\" | cut -f2 | while IFS= read -r _m; do printf 'FAULT %s carries no id\\n' \"${_m#$LA_HOME/}\"; done\n  grep -v '^MISSING' \"$_t.all\" | sort > \"$_t.bodies\"\n  cut -f1 \"$_t.reg\" | sort > \"$_t.rid\"\n  # LE DOCTEUR EST UN OUTIL MOTEUR (MOUSSA, 21/10) : ses corps portent des identifiants\n  # ranges dans registry-engine.yaml, pas dans registry.yaml. On reunit les deux.\n  _re=$(cfg abs registry_engine 2>/dev/null)\n  [ -n \"$_re\" ] && awk '/^[ \\t]*- id:/ { v = $0 ; sub(/.*- id:[ \\t]*/, \"\", v) ; gsub(/[^0-9A-Za-z]/, \"\", v) ; print v }' \"$_re\" >> \"$_t.rid\"\n  sort -u \"$_t.rid\" > \"$_t.rid2\" && mv \"$_t.rid2\" \"$_t.rid\"\n  cut -f1 \"$_t.bodies\" | sort > \"$_t.bid\"\n  _x=$(comm -13 \"$_t.rid\" \"$_t.bid\" | head -n 6 | tr '\\n' ' ')\n  _y=$(comm -23 \"$_t.rid\" \"$_t.bid\" | head -n 6 | tr '\\n' ' ')\n  [ -z \"$_x\" ] || printf 'FAULT id in a body and not in the register: %s\\n' \"$_x\"\n  [ -z \"$_y\" ] || printf 'FAULT id in the register and in no body: %s\\n' \"$_y\"\n  printf 'ok %s id(s) in the register, %s in the bodies\\n' \"$(wc -l < \"$_t.rid\" | tr -d ' ')\" \"$(wc -l < \"$_t.bid\" | tr -d ' ')\"\n  ;;\npaths)\n  _n=0\n  for _p in $(grep -ohE '(/home/[A-Za-z0-9_./+-]+)' \"$_td\"/*/tool_*.yaml 2>/dev/null | sort -u); do\n    _n=$((_n + 1))\n    [ -e \"$_p\" ] || printf 'FAULT cited and absent: %s\\n' \"$_p\"\n  done\n  printf 'ok %s path(s) cited by the bodies, all there\\n' \"$_n\"\n  ;;\n*) printf 'FAULT unknown op %s\\n' \"$_op\" ;;\nesac\nrm -f \"$_t\".*\nexit 0","result":"ok 2539 id(s) in the register, 2539 in the bodies","ts":1792557502,"return":""}
