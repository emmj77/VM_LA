{"status":"ok","tool":"doctor.language","line":"\n_op=${1:-vocab}\n_n=0\n_bad=0\nfor _d in engine programs conf tools; do\n  _p=$(cfg path \"$_d\" 2>/dev/null) || continue\n  [ -d \"$_p\" ] || continue\n  for _f in $(find \"$_p\" -type f \\( -name '*.sh' -o -name '*.py' \\) 2>/dev/null); do\n    # board.py parle francais a l humain (MOUSSA, 21/10) : le docteur l ignore\n    case ${_f##*/} in board.py) continue ;; esac\n    _n=$((_n + 1))\n    # LE FRANCAIS VIT DANS LES COMMENTAIRES ET DANS texts.yaml (MOUSSA, 21/10). On ne\n    # regarde que le code .sh/.py, hors lignes de commentaire, et le motif d avant\n    # avait des doubles barres obliques : il attrapait tout fichier avec un chiffre.\n    _h=$(LC_ALL=C grep -nP '[^\\x00-\\x7F]' \"$_f\" 2>/dev/null | grep -vcP '^[0-9]+:[[:space:]]*#' 2>/dev/null)\n    [ \"${_h:-0}\" = 0 ] || { _bad=$((_bad + 1)); printf 'FAULT %s carries %s line(s) with a french letter\\n' \"${_f#$ROOT/}\" \"$_h\"; }\n  done\ndone\nfor _w in $(cfg list lists.french 2>/dev/null); do\n  # un mot francais dans un COMMENTAIRE est permis (MOUSSA, 21/10) : on ne compte que le code\n  _c=$(LC_ALL=C grep -rIn --include='*.sh' --include='*.py' --exclude='board.py' \"\\b$_w\\b\" \"$(cfg path engine)\" \"$(cfg path programs)\" 2>/dev/null | grep -vP '^[^:]+:[0-9]+:[[:space:]]*#' | wc -l | tr -d ' ')\n  [ \"$_c\" = 0 ] || { _bad=$((_bad + 1)); printf 'FAULT the word \"%s\" lives in %s file(s)\\n' \"$_w\" \"$_c\"; }\ndone\n[ \"$_bad\" = 0 ] && printf 'ok %s file(s) read, no french in the machinery\\n' \"$_n\" \\\n  || printf 'FAULT %s file(s) speak french\\n' \"$_bad\"\nexit 0","result":"ok 21 file(s) read, no french in the machinery","ts":1792557502,"return":""}
