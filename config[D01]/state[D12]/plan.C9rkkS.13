{"status":"ok","tool":"doctor.machine","line":"\n_op=${1:-residents}\ncase $_op in\nresidents)\n  _ht=$(cfg num limits.health_timeout) || _ht=3\n  _n=0\n  for _u in $(_flat | awk -F'\\t' '$1 ~ /^units\\.[a-z_]+\\.unit$/ { k = $1; sub(/^units\\./, \"\", k); sub(/\\.unit$/, \"\", k); print k }'); do\n    _n=$((_n + 1))\n    _un=$(cfg str \"units.$_u.unit\") || continue\n    _pt=$(cfg num \"units.$_u.port\") || { printf 'note %s carries no port\\n' \"$_u\"; continue; }\n    _pb=$(cfg str \"units.$_u.probe\") || _pb=/\n    if ! systemctl --user is-active --quiet \"$_un\" 2>/dev/null; then\n      printf 'note %s is stopped (%s): a body that needs it will refuse\\n' \"$_un\" \"$_pt\"\n      continue\n    fi\n    _r=$(curl -s -o /dev/null -w '%{http_code}' --max-time \"$_ht\" \"http://$(cfg str models.host 127.0.0.1):$_pt$_pb\" 2>/dev/null)\n    case $_r in\n      200) printf 'ok %s holds %s%s\\n' \"$_un\" \"$_pt\" \"$_pb\" ;;\n      000) printf 'FAULT %s is active and %s does not answer\\n' \"$_un\" \"$_pt\" ;;\n      *)   printf 'note %s answers %s on %s%s\\n' \"$_un\" \"$_r\" \"$_pt\" \"$_pb\" ;;\n    esac\n  done\n  [ \"$_n\" -gt 0 ] && printf 'ok %s resident(s) declared\\n' \"$_n\" || printf 'FAULT la_config declares no unit\\n'\n  ;;\ninstruments)\n  for _b in tesseract ffmpeg jq sqlite3 curl; do\n    command -v \"$_b\" >/dev/null 2>&1 && printf 'ok %s answers\\n' \"$_b\" \\\n      || printf 'FAULT %s is missing: the bodies that call it read nothing\\n' \"$_b\"\n  done\n  if command -v tesseract >/dev/null 2>&1; then\n    _l=$(tesseract --list-langs 2>/dev/null | sed -n '2,$p' | tr '\\n' ' ')\n    printf 'ok tesseract languages: %s\\n' \"$_l\"\n  fi\n  ;;\nbenches)\n  _d=${LA_BENCHES:-}\n  if [ -z \"$_d\" ]; then\n    printf 'note no bench declared (LA_BENCHES): a work artefact, not the repo\\n'\n  elif [ -x \"$_d/banc_selecteur.sh\" ]; then\n    _b=$(timeout \"$(cfg num limits.bench_timeout 120)\" dash \"$_d/banc_selecteur.sh\" 2>&1 | tail -n 1)\n    case $_b in\n      *\"0 non conforme\"*) printf 'ok benches: %s\\n' \"$_b\" ;;\n      \"\")                 printf 'note the bench selector said nothing\\n' ;;\n      *)                  printf 'FAULT benches: %s\\n' \"$_b\" ;;\n    esac\n  else\n    printf 'note no bench at %s\\n' \"$_d\"\n  fi\n  ;;\ntunnel)\n  if ! command -v tailscale >/dev/null 2>&1; then\n    printf 'note tailscale is not installed: the phone reaches the bridge another way\\n'\n  else\n    _st=$(timeout 10 tailscale status --json 2>/dev/null | jq -r '.BackendState // \"unknown\"' 2>/dev/null)\n    _ip=$(timeout 10 tailscale ip -4 2>/dev/null | head -n 1)\n    _pe=$(timeout 10 tailscale status 2>/dev/null | grep -c . )\n    case ${_st:-} in\n      Running) printf 'ok tailscale is up, address %s\\n' \"${_ip:-none}\" ;;\n      \"\")      printf 'FAULT tailscale says nothing\\n' ;;\n      *)       printf 'FAULT tailscale is %s\\n' \"$_st\" ;;\n    esac\n    printf 'note %s line(s) of peers\\n' \"${_pe:-0}\"\n  fi\n  _bd=$(cfg num ports.bridge) || _bd=8770\n  _bl=$(ss -ltn 2>/dev/null | awk -v p=\":$_bd\" '$4 ~ p\"$\" { n++ } END { print n+0 }')\n  [ \"${_bl:-0}\" -gt 0 ] && printf 'ok the bridge listens on %s\\n' \"$_bd\" \\\n    || printf 'FAULT the bridge listens on nothing at %s\\n' \"$_bd\"\n  ;;\n*) printf 'FAULT unknown op %s\\n' \"$_op\" ;;\nesac\nexit 0","result":"ok tailscale is up, address 100.66.81.33\nnote 2 line(s) of peers\nok the bridge listens on 8770","ts":1792553849,"return":""}
