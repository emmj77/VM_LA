{"status":"ok","tool":"doctor.manifest","line":"\n_op=${1:-manifest}\n_st=$(cfg path state) || exit 0\n_rt=$(cfg path returns 2>/dev/null)\n_td=$(cfg path tools) || exit 0\n_t=$(tmpfile doctor_manifest) || exit 0\ncfg tree > \"$_t.decl\" || { printf 'FAULT the tree cannot be read\\n'; exit 0; }\n: > \"$_t.miss\"\n_n=0\nwhile IFS=\"$(printf '\\t')\" read -r _k _p _id; do\n  _n=$((_n + 1))\n  case $_p in *\"state[D12]\"*|*state/*) continue ;; esac\n  case $_k in dir) _a=$(cfg here \"$_p\") ;; *) _a=$(cfg here \"$_p\") ;; esac\n  [ -e \"$_a\" ] || printf '%s\\t%s\\n' \"$_k\" \"$_p\" >> \"$_t.miss\"\ndone < \"$_t.decl\"\n_m=$(wc -l < \"$_t.miss\" | tr -d ' ')\n[ \"$_m\" = 0 ] && printf 'ok %s entrie(s) declared, all on the disk\\n' \"$_n\" \\\n  || { printf 'FAULT %s entrie(s) declared and absent\\n' \"$_m\"; sed -n '1,8p' \"$_t.miss\" | sed 's/^/    /'; }\ncut -f2 \"$_t.decl\" > \"$_t.paths\"\n: > \"$_t.und\"\nfind \"$ROOT\" -type f ! -path \"$ROOT/.git/*\" ! -path \"$_td\"/* ! -path \"$_st\"/* \\\n     ! -path \"$ROOT/work\"/* ! -path \"$ROOT/docs\"/* ! -name '.*' 2>/dev/null | while read -r _x; do\n  _r=${_x#$ROOT/}\n  grep -qxF \"$_r\" \"$_t.paths\" || printf '%s\\n' \"$_r\" >> \"$_t.und\"\ndone\n_u=$(wc -l < \"$_t.und\" | tr -d ' ')\n[ \"$_u\" = 0 ] && printf 'ok no file is a stranger to the document\\n' \\\n  || { printf 'FAULT %s file(s) exist and the document names none of them\\n' \"$_u\"; sed -n '1,8p' \"$_t.und\" | sed 's/^/    /'; }\nrm -f \"$_t\".*\nexit 0","result":"FAULT 121 entrie(s) declared and absent\n    dir\tapplet[D02]\n    dir\taudio[D03]\n    dir\tcerts[D04]\n    dir\tconf[D05]\n    dir\tdata[D06]\n    dir\tengine[D07]\n    dir\tfilter[D08]\n    dir\tpage[D09]\nok no file is a stranger to the document","ts":1792553849,"return":""}
