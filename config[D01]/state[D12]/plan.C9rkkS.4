{"status":"ok","tool":"doctor.keys","line":"\n_op=${1:-keys}\nif [ \"$_op\" = used ]; then\n  # every name a body asks the config for must be in the config\n  _tf=$(tmpfile keysused) || exit 0\n  : > \"$_tf\"\n  for _f in \"$(cfg path tools)\"/*/tool_*.yaml \"$(cfg path engine)\"/*.sh; do\n    [ -f \"$_f\" ] || continue\n    grep -ohE 'cfg (str|num|path|abs|list|has|dir|file) [A-Za-z_0-9.]+' \"$_f\" 2>/dev/null | awk '{print $3}' >> \"$_tf\"\n  done\n  sort -u \"$_tf\" -o \"$_tf\"\n  _bad=0; _n=0\n  while IFS= read -r _k; do\n    case $_k in \"\"|*\\$*|*\"?\"*) continue ;; esac\n    _n=$((_n + 1))\n    if _flat | cut -f1 | grep -qxF \"$_k\"; then continue; fi\n    [ -n \"$(cfg abs \"$_k\" 2>/dev/null)\" ] && continue\n    [ -n \"$(cfg dir \"$_k\" 2>/dev/null)\" ] && continue\n    printf 'FAULT a body reads %s and la_config carries it nowhere\\n' \"$_k\"\n    _bad=$((_bad + 1))\n  done < \"$_tf\"\n  printf 'note %s name(s) asked by the bodies, %s unknown to the config\\n' \"$_n\" \"$_bad\"\n  exit 0\nfi\n\nexit 0","result":"","ts":1792553848,"return":""}
