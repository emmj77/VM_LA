{"status":"ok","tool":"doctor.structure","line":"\n_op=${1:-root}\ncase $_op in\nroot)\n  [ -d \"$ROOT\" ] && printf 'ok root %s\\n' \"$ROOT\" || printf 'FAULT root absent: %s\\n' \"$ROOT\"\n  for _k in la_config texts registry; do\n    _f=$(cfg abs \"$_k\" 2>/dev/null)\n    if [ -n \"$_f\" ] && [ -f \"$_f\" ]; then printf 'ok %s %s\\n' \"$_k\" \"${_f#$ROOT/}\"\n    else printf 'FAULT %s is not on the disk\\n' \"$_k\"; fi\n  done\n  _n=$(cfg tree | wc -l | tr -d ' ')\n  [ \"$_n\" -gt 0 ] && printf 'ok the tree is read, %s entries\\n' \"$_n\" \\\n    || printf 'FAULT the tree of la_config is empty: nothing is declared\\n'\n  ;;\nscripts)\n  _n=0\n  for _f in \"$(cfg path engine)\"/*.sh; do\n    [ -f \"$_f\" ] || continue\n    _n=$((_n + 1))\n    dash -n \"$_f\" 2>/dev/null || printf 'FAULT dash cannot read %s\\n' \"${_f##*/}\"\n  done\n  [ \"$_n\" -gt 0 ] && printf 'ok %s brick(s), syntax held\\n' \"$_n\" \\\n    || printf 'FAULT no brick in the engine\\n'\n  ;;\nprograms)\n  _d=$(cfg path programs) || { printf 'FAULT no programs directory\\n'; exit 0; }\n  _n=0\n  for _f in \"$_d\"/*.py; do\n    [ -f \"$_f\" ] || continue\n    _n=$((_n + 1))\n    python3 -B -c 'import ast,sys;ast.parse(open(sys.argv[1],encoding=\"utf-8\").read())' \"$_f\" 2>/dev/null \\\n      || printf 'FAULT python cannot read %s\\n' \"${_f##*/}\"\n  done\n  [ \"$_n\" -gt 0 ] && printf 'ok %s program(s), syntax held\\n' \"$_n\" \\\n    || printf 'FAULT no program in programs\\n'\n  ;;\n*) printf 'FAULT unknown op %s\\n' \"$_op\" ;;\nesac\nexit 0","result":"ok 16 brick(s), syntax held","ts":1792557501,"return":""}
