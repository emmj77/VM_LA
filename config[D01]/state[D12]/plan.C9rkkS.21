{"status":"ok","tool":"doctor.index","line":"\n_op=${1:-tree}\n_ix=$(cfg abs index_la) || { printf 'FAULT no index in the tree\\n'; exit 0; }\ncase $_op in\ntree)\n  _n=0; _miss=0\n  _tf=$(tmpfile idxmiss) || exit 0\n  : > \"$_tf\"\n  grep -oE 'path: \"[^\"]+\"' \"$_ix\" | sed 's/^path: \"//; s/\"$//' | while IFS= read -r _p; do\n    case $_p in *\"/state[\"*) continue ;; esac        # runtime: created on use, absent at rest\n    [ -e \"$ROOT/$_p\" ] || printf 'FAULT the index names %s and the disk holds nothing\\n' \"$_p\"\n  done > \"$_tf\"\n  cat \"$_tf\"\n  _miss=$(grep -c . \"$_tf\")\n  _n=$(grep -cE 'path: \"' \"$_ix\")\n  printf 'note %s path(s) in the index, %s absent from the disk\\n' \"$_n\" \"${_miss:-0}\"\n  _tf=$(tmpfile idxextra)\n  ( cd \"$ROOT\" && find . -type f \\( -name '*.yaml' -o -name '*.yml' -o -name '*.sh' -o -name '*.py' -o -name '*.md' -o -name '*.txt' -o -name '*.json' -o -name '*.html' -o -name '*.css' -o -name '*.js' \\) \\\n      -not -path './.git*' -not -path './work*' -not -path './skills*' -not -path './projects*' -not -path './docs*' \\\n      -not -path './config*/state*' -not -path './config*/audio*' -not -path './config*/data*' \\\n      -not -name 'tool_*.yaml' -not -path '*/__pycache__/*' ) | sed 's|^\\./||' | sort | while IFS= read -r _f; do\n    grep -qF \"path: \\\"$_f\\\"\" \"$_ix\" || printf 'note %s is on the disk and the index does not name it\\n' \"$_f\"\n  done > \"$_tf\"\n  cat \"$_tf\"\n  printf 'note %s file(s) on the disk and outside the index\\n' \"$(grep -c . \"$_tf\")\"\n  ;;\n*) printf 'FAULT unknown op %s\\n' \"$_op\" ;;\nesac\nexit 0","result":"note 0 path(s) in the index, 0 absent from the disk\nnote ARCHITECTURE_LA.txt is on the disk and the index does not name it\nnote DECISION.txt is on the disk and the index does not name it\nnote config[D01]/applet[D02]/applet.js is on the disk and the index does not name it\nnote config[D01]/applet[D02]/metadata.json is on the disk and the index does not name it\nnote