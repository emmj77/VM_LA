{"status":"ok","tool":"doctor.knowledge","line":"\n_op=${1:-skills}\ncase $_op in\nskills)\n  _d=$(cfg path skills) || { printf 'FAULT no skills directory\\n'; exit 0; }\n  _n=0\n  for _s in \"$_d\"/*/skill.yaml; do\n    [ -f \"$_s\" ] || continue\n    _n=$((_n + 1))\n    _nm=$(basename -- \"$(dirname -- \"$_s\")\")\n    grep -q '^PERIMETER:' \"$_s\" || printf 'FAULT skill %s carries no PERIMETER\\n' \"$_nm\"\n    grep -q '^  workspace:' \"$_s\" || printf 'FAULT skill %s carries no workspace\\n' \"$_nm\"\n    grep -q '^TOOLS:' \"$_s\" || printf 'FAULT skill %s carries no TOOLS\\n' \"$_nm\"\n  done\n  [ \"$_n\" -gt 0 ] && printf 'ok %s skill(s) read\\n' \"$_n\" || printf 'FAULT no skill in skills\\n'\n  ;;\nactive)\n  _s=$(skl_skill 2>/dev/null)\n  _p=$(skl_project 2>/dev/null)\n  _d=$(cfg path skills) || exit 0\n  if [ -n \"$_s\" ]; then\n    [ -f \"$_d/$_s/skill.yaml\" ] && printf 'ok the armed skill is %s, and it exists\\n' \"$_s\" \\\n      || printf 'FAULT skills/.active names %s, which does not exist\\n' \"$_s\"\n  else\n    printf 'ok no armed skill\\n'\n  fi\n  [ -n \"$_p\" ] && printf 'ok the armed project is %s\\n' \"$_p\" || printf 'ok no armed project\\n'\n  ;;\ncanon)\n  _ap=$(cfg str active_project 2>/dev/null)\n  [ -n \"$_ap\" ] || { printf 'ok no armed project, so no canon to hold\\n'; exit 0; }\n  _f=$(canon_path 2>/dev/null) || { printf 'FAULT no canon: the armed project names none\\n'; exit 0; }\n  [ -s \"$_f\" ] || { printf 'FAULT the canon %s is empty\\n' \"${_f#$ROOT/}\"; exit 0; }\n  _d=$(grep -oE '^  [0-9]+:' \"$_f\" | sort | uniq -d | tr '\\n' ' ')\n  [ -z \"$_d\" ] || printf 'FAULT law used twice:%s\\n' \"$_d\"\n  _l=$(awk 'length($0) > 100' \"$_f\" | wc -l | tr -d ' ')\n  [ \"$_l\" = 0 ] || printf 'FAULT %s line(s) of the canon pass 100 bytes\\n' \"$_l\"\n  printf 'ok canon %s, %s law(s)\\n' \"${_f#$ROOT/}\" \"$(grep -cE '^  [0-9]+:' \"$_f\")\"\n  ;;\n*) printf 'FAULT unknown op %s\\n' \"$_op\" ;;\nesac\nexit 0","result":"ok no armed skill\