# --- SECRETS ET PRIVE : JAMAIS publies (ce depot est PUBLIC) ---
memory/
config/.env
config/certs/
config/sessions.yaml
config/sessions.db
config/sessions.db-journal
# la memoire porte des faits PRIVES (comme memory/, deja ignore plus haut) : meme main que la
# base des sessions, jamais dans un depot public.
config/memory.db
config/memory.db-journal

# --- EXECUTION ET ETAT LOCAL (pas du source) ---
work/
config/audio/
config/backups/
*.pid
*.log

# --- LE FILTRE : le CORPUS est du source, le MODELE est un produit (il se refait en 60 ms) ---
config/filtre/*.bin
config/filtre/*.vec
config/filtre/propre.txt
config/filtre/appris.txt
config/filtre/essai*.txt

# --- DIVERS ---
.DS_Store
*.swp
